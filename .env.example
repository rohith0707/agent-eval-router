# LLM provider credentials — put real values in Vercel Environment Variables only.
NVIDIA_API_KEY=
HF_TOKEN=
OPENROUTER_API_KEY=

# Provider routing: auto = NVIDIA -> Hugging Face -> OpenRouter on failure.
EVAL_PROVIDER=auto
NVIDIA_MODEL=meta/llama-3.2-3b-instruct
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
OPENROUTER_MODEL=openai/gpt-oss-20b:free
PROVIDER_TIMEOUT_MS=15000

# Neon / PostgreSQL persistence.
DATABASE_URL=
# Vercel/Neon may also provide POSTGRES_PRISMA_URL or POSTGRES_URL.
