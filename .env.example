# NVIDIA NIM (server-side only; never expose this as NEXT_PUBLIC_*)
NVIDIA_API_KEY="nvapi-..."
NVIDIA_MODEL="meta/llama-3.3-70b-instruct"

# Neon / PostgreSQL persistence.
# Vercel's Neon integration may provide POSTGRES_PRISMA_URL or POSTGRES_URL;
# the application accepts those names too.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/agent_eval_router"
# Optional fallback mode. Keep false/unset for real evidence.
# ALLOW_EVAL_FALLBACK="false"
