# LLM provider credentials — put real values in Vercel Environment Variables only.
# Canonical names are preferred. The application also accepts the legacy
# aliases Gemini_API and Huggingface so existing deployments keep working.
GEMINI_API_KEY=
HF_TOKEN=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Provider routing: Gemini -> Hugging Face -> NVIDIA -> OpenRouter on failure.
EVAL_PROVIDER=auto
PROVIDER_ATTEMPT_TIMEOUT_MS=3500
PROVIDER_TOTAL_DEADLINE_MS=50000

# Optional model overrides. Leave unset to use the internal model registry.
# GEMINI_MODELS=gemini-2.5-flash-lite,gemini-3.1-flash-lite
# HUGGINGFACE_MODELS=google/gemma-2-2b-it,Qwen/Qwen3-4B-Thinking-2507
# NVIDIA_MODELS=meta/llama-3.2-1b-instruct,meta/llama-3.2-3b-instruct
# OPENROUTER_MODELS=openrouter/free

# Neon / PostgreSQL persistence.
DATABASE_URL=
# Vercel/Neon may also provide POSTGRES_PRISMA_URL or POSTGRES_URL.
