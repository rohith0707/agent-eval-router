{
  "name": "agent-eval-router",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:grader": "node scripts/test-benchmark-grader.mjs",
    "test:phase1": "node scripts/test-phase1.mjs",
    "test": "npm run test:phase1 && npm run test:grader",
    "validate:benchmark": "node scripts/validate-benchmark.mjs",
    "validate:benchmark:grader": "node scripts/validate-benchmark-grader.mjs",
    "validate:experiment": "node scripts/validate-experiment.mjs",
    "validate:production-contract": "node scripts/validate-production-contract.mjs",
    "db:migrate": "RUN_DB_MIGRATIONS=1 node scripts/vercel-build.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "next": "15.5.12",
    "react": "^19.1.4",
    "react-dom": "^19.1.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "prisma": "^6.19.2",
    "tailwindcss": "^4.3.3"
  }
}
