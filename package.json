{
  "name": "agent-eval-router",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:grader": "node scripts/test-benchmark-grader.mjs",
    "test:phase1": "node scripts/test-phase1.mjs",
    "test:regression-gate": "node scripts/test-regression-gate.mjs",
    "test:benchmark-evidence": "node scripts/test-benchmark-evidence.mjs",
    "test:benchmark-batching": "node scripts/test-benchmark-batching.mjs",
    "test:provider-registry": "node scripts/test-provider-registry.mjs",
    "test:meta-contract": "node scripts/test-meta-contract.mjs",
    "test:agentic-runtime": "node scripts/test-agentic-runtime-contract.mjs",
    "test:experiment-batching": "node scripts/test-experiment-batching.mjs",
    "test": "npm run test:phase1 && npm run test:grader && npm run test:regression-gate && npm run test:benchmark-evidence && npm run test:benchmark-batching && npm run test:provider-registry && npm run test:meta-contract && npm run test:agentic-runtime && npm run test:experiment-batching",
    "validate:benchmark": "node scripts/validate-benchmark.mjs",
    "validate:benchmark:grader": "node scripts/validate-benchmark-grader.mjs",
