generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EvaluationRun {
  id             String   @id @default(cuid())
  externalId     String   @unique
  task           String
  status         String
  selectedModel  String
  reason         String
  quality        Float
  latencyMs      Int
  cost           Float
  reliability    Float
  provider       String   @default("unknown")
  category       String   @default("general")
  strategy       String   @default("adaptive")
  costUsd        Float    @default(0)
  candidatesJson Json
  traceJson      Json
  createdAt      DateTime @default(now())

  @@index([provider])
  @@index([createdAt])
}

model EvaluationCase {
  id             String   @id
  task           String
  category       String
  difficulty     String
  expectedOutput Json?
  createdAt      DateTime @default(now())
}
